{
  "name": "freeword",
  "version": "1.1.0",
  "description": "FreeWord — offline Word-like document editor",
  "author": "FreeWord contributors",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/run-electron-safe.mjs electron-vite dev",
    "dev:nosandbox": "node scripts/run-electron-safe.mjs electron-vite dev -- --no-sandbox",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "python scripts/make-icon.py",
    "dist:win": "electron-vite build && node scripts/run-electron-safe.mjs electron-builder --win",
    "dist:mac": "electron-vite build && node scripts/run-electron-safe.mjs electron-builder --mac",
    "dist:linux": "electron-vite build && node scripts/run-electron-safe.mjs electron-builder --linux",
    "dist:all": "electron-vite build && node scripts/run-electron-safe.mjs electron-builder --win --mac --linux"
  },
  "dependencies": {
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-bold": "^3.31.3",
    "@tiptap/extension-color": "^3.31.3",
    "@tiptap/extension-heading": "^3.31.3",
    "@tiptap/extension-highlight": "^3.31.3",
    "@tiptap/extension-history": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-italic": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-paragraph": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-strike": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/extension-table-cell": "^3.31.3",
    "@tiptap/extension-table-header": "^3.31.3",
    "@tiptap/extension-table-row": "^3.31.3",
    "@tiptap/extension-text": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-text-style": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "fflate": "^0.8.3",
    "globals": "^16.5.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
